---
/** <LangSwitch current="en" links={[{lang:'en',label:'English',href:'/'},{lang:'fr',label:'Français',href:'/fr/'}]}> */
export interface Props { current: string; links: { lang: string; label: string; href: string }[] }
const { current, links } = Astro.props;
---
<ul class="lang-switch" aria-label="Language">
  {links.map((l) => (
    <li><a href={l.href} lang={l.lang} hreflang={l.lang} aria-current={l.lang === current ? 'true' : undefined} aria-label={l.label}><span class="lang-switch__long">{l.label}</span><span class="lang-switch__short" aria-hidden="true">{l.lang.slice(0, 2).toUpperCase()}</span></a></li>
  ))}
</ul>
<style>
  .lang-switch { list-style: none; margin: 0; padding: 0; display: inline-flex; border: 1px solid var(--rule); border-radius: var(--radius-button); overflow: hidden; background: var(--card); }
  .lang-switch a { display: block; padding: 6px 10px; font-family: var(--font-sans); font-size: var(--fs-eyebrow); font-weight: 600; letter-spacing: 0.02em; text-decoration: none; color: var(--ink-muted); }
  .lang-switch a[aria-current="true"] { background: var(--accent); color: var(--accent-ink); }
  .lang-switch a:not([aria-current]):hover { color: var(--accent); background: var(--accent-soft); }
  .lang-switch li + li { border-left: 1px solid var(--rule); }
  .lang-switch__short { display: none; }  /* shown instead of the long label where the header is tight (see Header.astro) */
</style>
