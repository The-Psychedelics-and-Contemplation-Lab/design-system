---
/**
 * <Header> — institutional lockup + site navigation.
 * McGill's co-branding rule: the unit's mark sits to the RIGHT of the
 * McGill logo, separated by a vertical rule. The LDI–JGH logo follows the
 * same rule, then the site's own wordmark. On narrow screens the partner
 * logo hides (it stays in the footer) so the lockup never wraps.
 */
export interface NavItem { label: string; href: string; current?: boolean; external?: boolean; children?: { label: string; href: string }[] }
export interface Props {
  siteName: string;              // wordmark text, e.g. "The ReSPCT Guidelines"
  siteTagline?: string;          // small line under the wordmark (optional)
  homeHref?: string;
  nav: NavItem[];
  mcgillLogo: string;            // URL of the McGill SVG (served by the site)
  partnerLogo?: string;          // URL of the LDI–JGH SVG
  partnerAlt?: string;
  menuLabel?: string;            // "Menu" / "Menu"
  lang?: string;
  siteLogo?: string;             // optional mark rendered inside the brand link, before the wordmark
  siteLogoAlt?: string;
}
const {
  siteName, siteTagline, homeHref = '/', nav, mcgillLogo, partnerLogo,
  partnerAlt = 'Lady Davis Institute for Medical Research — Jewish General Hospital',
  menuLabel = 'Menu', lang = 'en', siteLogo, siteLogoAlt = '',
} = Astro.props;
const hasAside = Astro.slots.has('aside');
// A header carrying both a site mark and an aside (language switch) is "crowded": on medium
// screens its navigation moves to a second, centred row instead of wrapping unevenly.
const crowded = hasAside && !!siteLogo;
---
<header class:list={['site-header', { 'site-header--crowded': crowded }]}>
  <div class="container site-header__inner">
    <div class="logo-lockup">
      <a class="logo-lockup__mcgill no-icon" href="https://www.mcgill.ca/" target="_blank" rel="noopener noreferrer" aria-label="McGill University (opens in a new tab)">
        <img src={mcgillLogo} alt="McGill University" width="176" height="42" decoding="async" />
      </a>
      {partnerLogo && (
        <a class="logo-lockup__partner no-icon" href="https://www.ladydavis.ca/" target="_blank" rel="noopener noreferrer" aria-label={`${partnerAlt} (opens in a new tab)`}>
          <img src={partnerLogo} alt={partnerAlt} width="146" height="82" decoding="async" />
        </a>
      )}
      <a class:list={['logo-lockup__brand', 'no-icon', { 'logo-lockup__brand--with-logo': !!siteLogo }]} href={homeHref} aria-current={nav.some(n => n.href === homeHref && n.current) ? 'page' : undefined}>
        {siteLogo && <img class="logo-lockup__mark" src={siteLogo} alt={siteLogoAlt} width="72" height="40" decoding="async" />}
        <span class="logo-lockup__text">
          <span class="logo-lockup__name">{siteName}</span>
          {siteTagline && <span class="logo-lockup__tagline">{siteTagline}</span>}
        </span>
      </a>
    </div>

    <details class="site-nav" id="site-nav" open>
      <summary class="site-nav__toggle" aria-label={menuLabel}>
        <span class="site-nav__burger" aria-hidden="true"></span>
        <span class="site-nav__toggle-label">{menuLabel}</span>
      </summary>
      <nav aria-label={lang.startsWith('fr') ? 'Navigation principale' : 'Primary'}>
        <ul class="site-nav__list">
          {nav.map((item) => item.children ? (
            <li class="site-nav__item has-children">
              <span class="site-nav__link-group">
                <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
                <button type="button" class="site-nav__subtoggle" aria-expanded="false" aria-label={`Show ${item.label} submenu`}>
                  <span class="site-nav__chevron" aria-hidden="true"></span>
                </button>
              </span>
              <ul class="site-nav__submenu">
                {item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >{item.label}</a>
            </li>
          ))}
          <li class="site-nav__extra"><slot name="extra" /></li>
        </ul>
      </nav>
    </details>
    {hasAside && <div class="site-header__aside"><slot name="aside" /></div>}
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .site-header__inner {
    min-height: var(--header-h);
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-6);
  }
  .logo-lockup { display: flex; align-items: center; gap: var(--s-4); min-width: 0; }
  .logo-lockup > a { display: flex; align-items: center; color: inherit; text-decoration: none; }
  .logo-lockup > a + a { border-left: 1px solid var(--rule); padding-left: var(--s-4); }
  .logo-lockup__mcgill img { height: 32px; width: auto; }
  .logo-lockup__partner img { height: 48px; width: auto; }
  .logo-lockup__brand { flex-direction: column; align-items: flex-start !important; gap: 2px; min-width: 0; }
  .logo-lockup__brand--with-logo { flex-direction: row; align-items: center !important; gap: var(--s-3); }
  .logo-lockup__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .logo-lockup__mark { height: 40px; width: auto; flex: none; }
  /* Optional right-hand slot (e.g. a language switch) outside the navigation list */
  .site-header__aside { display: flex; align-items: center; flex: none; }
  /* With an aside the navigation sits centred between the lockup and the aside */
  .site-header__inner:has(.site-header__aside) .site-nav { margin-inline: auto; }
  .logo-lockup__name {
    font-family: var(--font-serif); font-weight: 600; font-size: 1.125rem; line-height: 1.15;
    color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 40vw;
  }
  .logo-lockup__tagline { font-family: var(--font-sans); font-size: 0.75rem; line-height: 1.2; color: var(--ink-muted); white-space: nowrap; }
  .logo-lockup__brand:hover .logo-lockup__name { color: var(--accent); }

  /* Navigation — a <details> disclosure on small screens, inline on wide */
  .site-nav { border: 0; background: none; padding: 0; border-radius: 0; }
  .site-nav__toggle {
    display: inline-flex; align-items: center; gap: var(--s-2);
    padding: 8px 12px; border: 1px solid var(--rule); border-radius: var(--radius-button);
    background: var(--card); font-family: var(--font-sans); font-size: var(--fs-ui); font-weight: 600;
    margin: 0;
  }
  .site-nav__toggle::before { content: none; }
  .site-nav__burger { width: 16px; height: 2px; background: currentColor; position: relative; display: block; }
  .site-nav__burger::before, .site-nav__burger::after { content: ""; position: absolute; left: 0; width: 16px; height: 2px; background: currentColor; }
  .site-nav__burger::before { top: -5px; } .site-nav__burger::after { top: 5px; }
  .site-nav__list { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--s-1); align-items: center; }
  .site-nav__list a {
    display: block; padding: 8px 12px; border-radius: var(--radius-button);
    font-family: var(--font-sans); font-size: var(--fs-ui); font-weight: 500;
    color: var(--ink); text-decoration: none;
  }
  .site-nav__list a:hover { background: var(--accent-soft); color: var(--accent); }
  .site-nav__list a[aria-current="page"] { color: var(--accent); font-weight: 600; box-shadow: inset 0 -2px 0 var(--accent); border-radius: var(--radius-button) var(--radius-button) 0 0; }
  .site-nav__extra:empty { display: none; }

  /* Dropdown nav items (e.g. "Research" with Psychedelic/Contemplative sub-links): hover reveals it
     on wide screens; the chevron button is a tap target to open/close it on touch and small screens. */
  .site-nav__link-group { display: flex; align-items: center; }
  .site-nav__subtoggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; padding: 0; margin: 0; border: 0; background: none; cursor: pointer; color: inherit;
  }
  .site-nav__chevron {
    display: block; width: 7px; height: 7px;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg); transition: transform var(--dur) var(--ease);
  }
  .site-nav__item.has-children.is-open .site-nav__chevron { transform: rotate(225deg); }
  .site-nav__submenu { list-style: none; margin: 0; padding: 0; display: none; }
  .site-nav__item.has-children:hover .site-nav__submenu,
  .site-nav__item.has-children:focus-within .site-nav__submenu,
  .site-nav__item.has-children.is-open .site-nav__submenu {
    display: block;
  }

  @media (max-width: 59.99em) {
    .logo-lockup > .logo-lockup__partner { display: none; }
    .site-nav[open] .site-nav__toggle { border-color: var(--ink-muted); }
    .site-nav nav {
      position: absolute; left: 0; right: 0; top: 100%;
      background: var(--card); border-bottom: 1px solid var(--rule);
      box-shadow: var(--shadow-card);
      padding: var(--s-3) var(--gutter) var(--s-4);
    }
    .site-nav__list { flex-direction: column; align-items: stretch; }
    .site-nav__list a { padding: 12px 14px; font-size: 1.0625rem; }
    .site-nav__list a[aria-current="page"] { box-shadow: inset 3px 0 0 var(--accent); border-radius: var(--radius-button); }
    .site-nav__item.has-children .site-nav__link-group { justify-content: space-between; }
    .site-nav__item.has-children .site-nav__subtoggle { width: 40px; height: 40px; }
    .site-nav__item.has-children .site-nav__chevron { width: 8px; height: 8px; }
    .site-nav__submenu { padding-left: var(--s-4); }
    .site-nav__submenu a { padding: 10px 14px; font-size: 1rem; color: var(--ink-muted); }
  }
  @media (min-width: 60em) {
    .site-nav__toggle { display: none; }
    .site-nav nav { display: block; }
    .logo-lockup__name { max-width: 22rem; }
    .site-nav__list { flex-wrap: wrap; justify-content: flex-end; }
    .site-nav__item.has-children { position: relative; }
    .site-nav__item.has-children .site-nav__subtoggle { display: none; }
    .site-nav__submenu {
      position: absolute; top: 100%; left: 0; margin-top: var(--s-2); min-width: 14rem;
      background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius-button);
      box-shadow: var(--shadow-card); padding: var(--s-2);
    }
    .site-nav__submenu li + li { margin-top: 2px; }
    .site-nav__submenu a {
      display: block; padding: 8px 12px; border-radius: var(--radius-button);
      font-family: var(--font-sans); font-size: var(--fs-ui); font-weight: 500;
      color: var(--ink); text-decoration: none; white-space: nowrap;
    }
    .site-nav__submenu a:hover { background: var(--accent-soft); color: var(--accent); }
  }
  @media (min-width: 60em) and (max-width: 80em) {
    /* Long wordmarks may wrap on two lines instead of colliding with the nav */
    .logo-lockup__name { white-space: normal; max-width: 16rem; font-size: 1rem; }
    .logo-lockup__tagline { display: none; }
    /* …but next to a site mark the wordmark stays on one line (the text column must not be squeezed) */
    .logo-lockup__brand--with-logo .logo-lockup__text { flex: none; }
    .logo-lockup__brand--with-logo .logo-lockup__name { white-space: nowrap; }
    /* Slightly tighter lockup and nav so four to six items fit on one row at ~1100 px */
    .logo-lockup__mcgill img { height: 28px; }
    .logo-lockup__partner img { height: 42px; }
    .site-nav__list a { padding-inline: 10px; }
  }
  @media (min-width: 60em) and (max-width: 75em) {
    /* Crowded header (mark + language switch): the nav takes a full, centred second row */
    .site-header--crowded .site-header__inner { flex-wrap: wrap; row-gap: 0; }
    .site-header--crowded .site-nav { order: 3; flex: 1 0 100%; margin-inline: 0; border-top: 1px solid var(--rule); }
    .site-header--crowded .site-nav__list { justify-content: center; flex-wrap: nowrap; }
    .site-header--crowded .site-nav__list a { padding-block: 6px; }
    .site-header--crowded .logo-lockup__partner img { height: 40px; }
  }
  @media (max-width: 40em) {
    .logo-lockup__mcgill img { height: 26px; }
    .logo-lockup__mark { height: 30px; }
    .logo-lockup__name { font-size: 1rem; max-width: 46vw; }
    .logo-lockup__tagline { display: none; }
  }
</style>

<script>
  // Progressive enhancement: the menu is open by default (works without JS);
  // on narrow screens we collapse it and let <summary> toggle it.
  const nav = document.getElementById('site-nav') as HTMLDetailsElement | null;
  const mq = window.matchMedia('(max-width: 59.99em)');
  const sync = () => { if (nav) nav.open = !mq.matches; };
  sync();
  mq.addEventListener('change', sync);
  // Close the mobile menu after choosing a same-page anchor
  nav?.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', () => { if (mq.matches && nav) nav.open = false; }));

  // Dropdown nav items (e.g. "Research"): hover reveals the submenu on wide screens via CSS alone;
  // the chevron button below makes it tap-to-open on touch screens and inside the mobile menu.
  const closeDropdown = (item: Element) => {
    item.classList.remove('is-open');
    item.querySelector('.site-nav__subtoggle')?.setAttribute('aria-expanded', 'false');
  };
  document.querySelectorAll<HTMLLIElement>('.site-nav__item.has-children').forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('.site-nav__subtoggle');
    toggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      const opening = !item.classList.contains('is-open');
      document.querySelectorAll('.site-nav__item.has-children.is-open').forEach((other) => { if (other !== item) closeDropdown(other); });
      item.classList.toggle('is-open', opening);
      toggle.setAttribute('aria-expanded', opening ? 'true' : 'false');
    });
  });
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.site-nav__item.has-children.is-open').forEach((item) => {
      if (!(e.target instanceof Node) || !item.contains(e.target)) closeDropdown(item);
    });
  });
  mq.addEventListener('change', () => document.querySelectorAll('.site-nav__item.has-children.is-open').forEach(closeDropdown));
</script>
