---
/**
 * <Figure src alt caption ratio="wide|tall|square|cinema" bleed drift width height />
 * A framed image with optional caption, full-bleed and slow inner drift (parallax).
 */
export interface Props { src: string; alt: string; caption?: string; ratio?: 'wide' | 'tall' | 'square' | 'cinema'; bleed?: boolean; drift?: boolean; fade?: boolean; width?: number; height?: number; loading?: 'lazy' | 'eager'; class?: string; srcset?: string; sizes?: string }
const { src, alt, caption, ratio = 'wide', bleed = false, drift = false, fade = false, width, height, loading = 'lazy', class: cls = '', srcset, sizes } = Astro.props;
---
<figure class={`figure figure--${ratio} ${bleed ? 'figure--bleed' : ''} ${drift ? 'figure--drift' : ''} ${cls}`}>
  <div class={`figure__frame ${fade ? 'img-fade' : ''}`}>
    <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" srcset={srcset} sizes={sizes} data-parallax={drift ? '-0.06' : undefined} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
