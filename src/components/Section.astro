---
/** <Section band? tight? wide? narrow? id?> — vertical rhythm wrapper. */
export interface Props { id?: string; band?: boolean; tight?: boolean; wide?: boolean; narrow?: boolean; class?: string; ariaLabelledby?: string }
const { id, band, tight, wide, narrow, class: cls = '', ariaLabelledby } = Astro.props;
const outer = ['section', band ? 'section--band' : '', tight ? 'section--tight' : '', cls].filter(Boolean).join(' ');
const inner = wide ? 'container--wide' : narrow ? 'container--narrow' : 'container';
---
<section id={id} class={outer} aria-labelledby={ariaLabelledby}><div class={inner}><slot /></div></section>
